# One Piece MMO — gitignore

# Clone LPC: versionado junto (assets editáveis). Ignorar só o .git interno
# (senão o Git trata a pasta como submodule sem arquivos).
vendor/**/node_modules/

# Godot
godot/.godot/
godot/**/*.translation
godot/export_presets.cfg
godot/.import/

# Backend / Go
backend/build/
*.so
*.exe

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.superpowers/
*.user
